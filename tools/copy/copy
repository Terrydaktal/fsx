#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || realpath -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
WORKSPACE_DIR="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
BIN="$WORKSPACE_DIR/target/release/copy-rs"

rust_source_is_newer() {
	find "$SCRIPT_DIR/src" "$WORKSPACE_DIR/crates/fsx/src" -type f -name '*.rs' -newer "$BIN" -print -quit | grep -q .
}

if [[ ! -x "$BIN" || "$WORKSPACE_DIR/Cargo.toml" -nt "$BIN" || "$WORKSPACE_DIR/Cargo.lock" -nt "$BIN" || "$SCRIPT_DIR/Cargo.toml" -nt "$BIN" || "$WORKSPACE_DIR/crates/fsx/Cargo.toml" -nt "$BIN" || "$WORKSPACE_DIR/.cargo/config.toml" -nt "$BIN" ]] || rust_source_is_newer; then
	cargo build --release --quiet --manifest-path "$WORKSPACE_DIR/Cargo.toml" -p copy-rs
fi

exec "$BIN" "$@"
